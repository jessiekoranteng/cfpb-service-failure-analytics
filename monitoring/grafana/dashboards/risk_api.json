{
 "uid": "risk-api",
 "title": "Complaint risk API (live traffic)",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "tags": [
  "cfpb",
  "final-project"
 ],
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests scored per minute",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (flagged) (rate(risk_api_predictions_total[5m])) * 60",
     "legendFormat": "flagged={{flagged}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Share flagged for review (expected 15% to 25%)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(risk_api_predictions_total{flagged=\"true\"}[30m])) / sum(rate(risk_api_predictions_total[30m]))",
     "legendFormat": "flagged share",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Requests with a value not seen in training (alert above 5%)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(risk_api_unseen_category_requests_total[30m])) / sum(rate(risk_api_predictions_total[30m]))",
     "legendFormat": "unseen share",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Scoring time, 95th percentile",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum(rate(risk_api_predict_seconds_bucket[5m])) by (le))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ]
  }
 ]
}